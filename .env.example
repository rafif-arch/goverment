# ============================================================
# PolSim Arcapada — Environment Variables
# Salin ke .env.local dan isi nilainya. JANGAN commit .env.local.
# ============================================================

# --- Supabase (project "Enterprise Asset Management", schema game: polsim) ---
NEXT_PUBLIC_SUPABASE_URL=https://nkqfdrgggrdwzseglyjm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-dari-dashboard
# Service role key: HANYA untuk server (route handlers, scripts). Jangan pernah diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-dari-dashboard

# --- BPS Web API (registrasi gratis di https://webapi.bps.go.id) ---
BPS_API_KEY=

# --- Midtrans (SANDBOX) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx

# --- n8n REST API (opsional, untuk npm run push:n8n) ---
N8N_API_URL=
N8N_API_KEY=

# --- Base URL aplikasi (untuk callback/redirect) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
