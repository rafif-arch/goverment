# ============================================================
# PolSim Arcapada — Environment Variables
# Salin: cp .env.example .env.local  → ganti semua <<...>>.
# Panduan lengkap per langkah: SETUP.md. JANGAN commit .env.local.
# ============================================================

# --- [SETUP.md Langkah 1] Supabase ------------------------------------------
# https://supabase.com/dashboard/project/nkqfdrgggrdwzseglyjm/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://nkqfdrgggrdwzseglyjm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<<TEMPEL_ANON_KEY>>
# service_role: HANYA server (webhook/admin/scripts) — jangan pernah ke client
SUPABASE_SERVICE_ROLE_KEY=<<TEMPEL_SERVICE_ROLE_KEY>>

# --- [Langkah 2] Midtrans SANDBOX -------------------------------------------
# https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=<<SB-Mid-server-...>>
MIDTRANS_CLIENT_KEY=<<SB-Mid-client-...>>
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=<<SB-Mid-client-... (sama dengan MIDTRANS_CLIENT_KEY)>>
MIDTRANS_IS_PRODUCTION=false

# --- [Langkah 3] BPS Web API (registrasi gratis) ----------------------------
# https://webapi.bps.go.id/developer — kosongkan = pakai fallback fiksi-realistis
BPS_API_KEY=

# --- [Langkah 4, opsional] n8n REST API utk `npm run push:n8n` --------------
N8N_API_URL=
N8N_API_KEY=

# --- Base URL aplikasi -------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
